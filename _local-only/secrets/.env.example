# Le chiavi degli strumenti collegati.
#
# Come si usa: copia questo file, rinomina la copia in  .env  (resta in questa cartella),
# e incolla le chiavi dopo il segno =, senza spazi e senza virgolette.
# Compila solo le righe degli strumenti che usi; le altre lasciale vuote.
#
# NON incollare mai una chiave nella chat con Claude. Il file .env non va su GitHub
# e Claude non puo' aprirlo: gli script lo leggono da soli quando servono.

# Granola: call che entrano da sole nel vault.
# Si genera nell'app Granola: Impostazioni > Connettori > API keys > Create new key.
# Serve il piano Business o superiore. La chiave comincia con grn_
GRANOLA_API_KEY=

# ClickUp: task del team nel Cruscotto.
# Si genera in ClickUp: il tuo avatar > Settings > Apps > API Token > Generate.
# La chiave comincia con pk_
CLICKUP_TOKEN=

# Facoltativo, solo per il giro posta quando gira da solo senza nessuno davanti.
# Si genera con il comando  claude setup-token  (chiedi a Claude di guidarti).
CLAUDE_CODE_OAUTH_TOKEN=
