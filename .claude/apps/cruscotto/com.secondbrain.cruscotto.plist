<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MODELLO, non un file pronto: contiene segnaposto che vanno sostituiti prima di installarlo.
    __VAULT__   percorso assoluto della cartella del vault (senza barra finale)
    __PYTHON__  percorso assoluto di un interprete python3 che esiste davvero
    __HOME__    percorso assoluto della tua cartella utente
  Come riempirli, installare, riavviare e disinstallare: .claude/apps/cruscotto/README.md
  Cosa fa: tiene acceso il Cruscotto. Parte al login e riparte da solo se si ferma.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.secondbrain.cruscotto</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__VAULT__/.claude/apps/cruscotto/server.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__VAULT__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/secondbrain-cruscotto.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/secondbrain-cruscotto.log</string>
</dict>
</plist>
